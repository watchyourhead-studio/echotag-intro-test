[{"start": 2.032, "end": 5.858, "text": "In diesem Bild offenbart sich eine Schönheit, die nicht durch Klarheit,", "confidence": 1.0, "newpara": true, "timestamps": [["In", 2.03, 2.21, 1.0], ["diesem", 2.21, 2.59, 1.0], ["Bild", 2.59, 2.95, 1.0], ["offenbart", 2.95, 3.44, 1.0], ["sich", 3.44, 3.63, 1.0], ["eine", 3.63, 3.84, 1.0], ["Schönheit,", 3.84, 4.56, 1.0], ["die", 4.56, 4.8, 1.0], ["nicht", 4.8, 5.02, 1.0], ["durch", 5.02, 5.25, 1.0], ["Klarheit,", 5.25, 5.86, 1.0]]}, {"start": 5.858, "end": 7.529, "text": "sondern durch Verfall spricht.", "confidence": 1.0, "timestamps": [["sondern", 5.86, 6.15, 1.0], ["durch", 6.15, 6.39, 1.0], ["Verfall", 6.39, 6.9, 1.0], ["spricht.", 6.9, 7.53, 1.0]]}, {"start": 8.348, "end": 13.351, "text": "Die verblassten Farben, die bröckelnden Strukturen und die schemenhafte Gestalt", "confidence": 1.0, "timestamps": [["Die", 8.35, 8.5, 1.0], ["verblassten", 8.5, 9.14, 1.0], ["Farben,", 9.14, 9.72, 1.0], ["die", 9.72, 9.95, 1.0], ["bröckelnden", 9.95, 10.51, 1.0], ["Strukturen", 10.51, 11.34, 1.0], ["und", 11.7, 11.86, 1.0], ["die", 11.86, 11.98, 1.0], ["schemenhafte", 11.98, 12.7, 1.0], ["Gestalt", 12.7, 13.35, 1.0]]}, {"start": 13.531, "end": 18.28, "text": "erinnern an das, was war, und gleichzeitig an das, was werden kann.", "confidence": 1.0, "timestamps": [["erinnern", 13.53, 14.0, 1.0], ["an", 14.0, 14.17, 1.0], ["das,", 14.17, 14.65, 1.0], ["was", 14.65, 15.02, 1.0], ["war,", 15.02, 15.38, 1.0], ["und", 15.74, 15.92, 1.0], ["gleichzeitig", 15.92, 16.61, 1.0], ["an", 16.61, 16.75, 1.0], ["das,", 16.75, 17.11, 1.0], ["was", 17.34, 17.58, 1.0], ["werden", 17.58, 17.91, 1.0], ["kann.", 17.91, 18.28, 1.0]]}, {"start": 18.75, "end": 22.448, "text": "Hier liegt kein klares Gesicht, sondern ein Abdruck der Zeit,", "confidence": 1.0, "timestamps": [["Hier", 18.75, 18.97, 1.0], ["liegt", 18.97, 19.23, 1.0], ["kein", 19.23, 19.48, 1.0], ["klares", 19.48, 19.96, 1.0], ["Gesicht,", 19.96, 20.51, 1.0], ["sondern", 20.72, 21.16, 1.0], ["ein", 21.16, 21.33, 1.0], ["Abdruck", 21.33, 21.75, 1.0], ["der", 21.75, 21.97, 1.0], ["Zeit,", 21.97, 22.45, 1.0]]}, {"start": 22.448, "end": 26.372, "text": "als hätte sie selbst ihre Spuren in die Oberfläche gegraben.", "confidence": 1.0, "timestamps": [["als", 22.45, 22.74, 1.0], ["hätte", 22.74, 23.06, 1.0], ["sie", 23.06, 23.25, 1.0], ["selbst", 23.25, 23.68, 1.0], ["ihre", 23.68, 23.91, 1.0], ["Spuren", 23.91, 24.51, 1.0], ["in", 24.74, 24.9, 1.0], ["die", 24.9, 25.06, 1.0], ["Oberfläche", 25.06, 25.65, 1.0], ["gegraben.", 25.65, 26.37, 1.0]]}, {"start": 27.127, "end": 32.125, "text": "Wie die Tarotkarte Tod steht auch dieses Werk nicht nur für das Ende,", "confidence": 1.0, "timestamps": [["Wie", 27.13, 27.28, 1.0], ["die", 27.28, 27.42, 1.0], ["Tarotkarte", 27.42, 28.38, 1.0], ["Tod", 28.56, 29.19, 1.0], ["steht", 29.57, 29.9, 1.0], ["auch", 29.9, 30.07, 1.0], ["dieses", 30.07, 30.43, 1.0], ["Werk", 30.43, 30.74, 1.0], ["nicht", 30.74, 31.01, 1.0], ["nur", 31.01, 31.17, 1.0], ["für", 31.17, 31.32, 1.0], ["das", 31.32, 31.57, 1.0], ["Ende,", 31.57, 32.12, 1.0]]}, {"start": 32.543, "end": 33.959, "text": "sondern für den Übergang.", "confidence": 1.0, "timestamps": [["sondern", 32.54, 32.93, 1.0], ["für", 32.93, 33.09, 1.0], ["den", 33.09, 33.28, 1.0], ["Übergang.", 33.28, 33.96, 1.0]]}, {"start": 34.331, "end": 37.018, "text": "Was einst klar war, löst sich auf.", "confidence": 1.0, "timestamps": [["Was", 34.33, 34.59, 1.0], ["einst", 34.59, 34.92, 1.0], ["klar", 34.92, 35.32, 1.0], ["war,", 35.32, 35.74, 1.0], ["löst", 35.96, 36.27, 1.0], ["sich", 36.27, 36.55, 1.0], ["auf.", 36.55, 37.02, 1.0]]}, {"start": 37.471, "end": 40.989, "text": "Und in dieser Auflösung liegt die Einladung zum Neubeginn.", "confidence": 1.0, "timestamps": [["Und", 37.47, 37.65, 1.0], ["in", 37.65, 37.76, 1.0], ["dieser", 37.76, 38.04, 1.0], ["Auflösung", 38.04, 38.71, 1.0], ["liegt", 38.71, 38.95, 1.0], ["die", 38.95, 39.12, 1.0], ["Einladung", 39.12, 39.87, 1.0], ["zum", 39.87, 40.15, 1.0], ["Neubeginn.", 40.15, 40.99, 1.0]]}, {"start": 41.593, "end": 46.864, "text": "Aus der Auflösung der alten Form entsteht Raum für Neues, für Wandlung,", "confidence": 1.0, "timestamps": [["Aus", 41.59, 41.87, 1.0], ["der", 41.87, 42.15, 1.0], ["Auflösung", 42.15, 43.0, 1.0], ["der", 43.0, 43.2, 1.0], ["alten", 43.2, 43.55, 1.0], ["Form", 43.55, 43.89, 1.0], ["entsteht", 43.89, 44.4, 1.0], ["Raum", 44.4, 44.7, 1.0], ["für", 44.7, 44.92, 1.0], ["Neues,", 44.92, 45.5, 1.0], ["für", 45.86, 46.14, 1.0], ["Wandlung,", 46.14, 46.86, 1.0]]}, {"start": 47.084, "end": 49.441, "text": "für Aufblühen aus dem Unsichtbaren.", "confidence": 1.0, "timestamps": [["für", 47.08, 47.37, 1.0], ["Aufblühen", 47.37, 48.09, 1.0], ["aus", 48.09, 48.29, 1.0], ["dem", 48.29, 48.47, 1.0], ["Unsichtbaren.", 48.47, 49.44, 1.0]]}, {"start": 49.958, "end": 55.798, "text": "Die Schönheit des Bildes liegt nicht in der Perfektion, sondern im Moment des Dazwischen.", "confidence": 1.0, "timestamps": [["Die", 49.96, 50.14, 1.0], ["Schönheit", 50.14, 50.68, 1.0], ["des", 50.68, 50.89, 1.0], ["Bildes", 50.89, 51.5, 1.0], ["liegt", 51.67, 51.98, 1.0], ["nicht", 51.98, 52.28, 1.0], ["in", 52.28, 52.4, 1.0], ["der", 52.4, 52.56, 1.0], ["Perfektion,", 52.56, 53.48, 1.0], ["sondern", 53.82, 54.23, 1.0], ["im", 54.23, 54.36, 1.0], ["Moment", 54.36, 54.77, 1.0], ["des", 54.77, 54.97, 1.0], ["Dazwischen.", 54.97, 55.8, 1.0]]}, {"start": 56.343, "end": 58.739, "text": "Im Verblassen und Erscheinen zugleich.", "confidence": 1.0, "timestamps": [["Im", 56.34, 56.52, 1.0], ["Verblassen", 56.52, 57.22, 1.0], ["und", 57.22, 57.43, 1.0], ["Erscheinen", 57.43, 58.01, 1.0], ["zugleich.", 58.01, 58.74, 1.0]]}, {"start": 59.424, "end": 64.329, "text": "Es ist ein Porträt der Verwandlung, ein Spiegel des Lebens, das uns lehrt,", "confidence": 1.0, "timestamps": [["Es", 59.42, 59.59, 1.0], ["ist", 59.59, 59.78, 1.0], ["ein", 59.78, 59.93, 1.0], ["Porträt", 59.93, 60.4, 1.0], ["der", 60.4, 60.57, 1.0], ["Verwandlung,", 60.57, 61.39, 1.0], ["ein", 61.69, 61.91, 1.0], ["Spiegel", 61.91, 62.38, 1.0], ["des", 62.38, 62.61, 1.0], ["Lebens,", 62.61, 63.17, 1.0], ["das", 63.39, 63.62, 1.0], ["uns", 63.62, 63.87, 1.0], ["lehrt,", 63.87, 64.33, 1.0]]}, {"start": 64.625, "end": 69.664, "text": "jeder Riss, jede Spur der Zeit ist nicht nur Zeichen des Endes,", "confidence": 1.0, "timestamps": [["jeder", 64.62, 65.07, 1.0], ["Riss,", 65.07, 65.49, 1.0], ["jede", 65.76, 66.08, 1.0], ["Spur", 66.08, 66.71, 1.0], ["der", 66.71, 67.03, 1.0], ["Zeit", 67.03, 67.54, 1.0], ["ist", 67.54, 67.82, 1.0], ["nicht", 67.82, 68.08, 1.0], ["nur", 68.08, 68.27, 1.0], ["Zeichen", 68.27, 68.74, 1.0], ["des", 68.74, 68.99, 1.0], ["Endes,", 68.99, 69.66, 1.0]]}, {"start": 70.099, "end": 72.05, "text": "sondern auch Tor zum Anfang.", "confidence": 1.0, "timestamps": [["sondern", 70.1, 70.55, 1.0], ["auch", 70.55, 70.78, 1.0], ["Tor", 70.78, 71.1, 1.0], ["zum", 71.1, 71.38, 1.0], ["Anfang.", 71.38, 72.05, 1.0]]}]