[{"start": 0.627, "end": 4.808, "text": "Dieses Werk ist das erste und damit auch das bedeutendste und persönlichste", "confidence": 1.0, "newpara": true, "timestamps": [["Dieses", 0.63, 0.98, 1.0], ["Werk", 0.98, 1.25, 1.0], ["ist", 1.25, 1.43, 1.0], ["das", 1.43, 1.66, 1.0], ["erste", 1.66, 2.19, 1.0], ["und", 2.19, 2.42, 1.0], ["damit", 2.42, 2.74, 1.0], ["auch", 2.74, 2.92, 1.0], ["das", 2.92, 3.11, 1.0], ["bedeutendste", 3.11, 3.94, 1.0], ["und", 3.94, 4.1, 1.0], ["persönlichste", 4.1, 4.81, 1.0]]}, {"start": 4.808, "end": 7.396, "text": "Bild meiner Serie Barfuß durch New York.", "confidence": 1.0, "timestamps": [["Bild", 4.81, 5.14, 1.0], ["meiner", 5.14, 5.46, 1.0], ["Serie", 5.46, 5.98, 1.0], ["Barfuß", 6.12, 6.59, 1.0], ["durch", 6.59, 6.91, 1.0], ["New", 6.91, 7.06, 1.0], ["York.", 7.06, 7.4, 1.0]]}, {"start": 7.912, "end": 11.697, "text": "New York fasziniert mich immer wieder aufs Neue, diese pulsierende Stadt,", "confidence": 1.0, "timestamps": [["New", 7.91, 8.05, 1.0], ["York", 8.05, 8.33, 1.0], ["fasziniert", 8.33, 9.01, 1.0], ["mich", 9.01, 9.2, 1.0], ["immer", 9.2, 9.44, 1.0], ["wieder", 9.44, 9.69, 1.0], ["aufs", 9.69, 9.91, 1.0], ["Neue,", 9.91, 10.3, 1.0], ["diese", 10.3, 10.63, 1.0], ["pulsierende", 10.63, 11.32, 1.0], ["Stadt,", 11.32, 11.7, 1.0]]}, {"start": 11.97, "end": 16.188, "text": "ihre Energie, ihre Gegensätze und das besondere Lebensgefühl,", "confidence": 1.0, "timestamps": [["ihre", 11.97, 12.24, 1.0], ["Energie,", 12.24, 12.85, 1.0], ["ihre", 12.85, 13.2, 1.0], ["Gegensätze", 13.2, 14.02, 1.0], ["und", 14.39, 14.54, 1.0], ["das", 14.54, 14.7, 1.0], ["besondere", 14.7, 15.27, 1.0], ["Lebensgefühl,", 15.27, 16.19, 1.0]]}, {"start": 16.188, "end": 19.708, "text": "das man spürt, wenn man zu Fuß durch ihre Straßen streift.", "confidence": 1.0, "timestamps": [["das", 16.19, 16.49, 1.0], ["man", 16.49, 16.67, 1.0], ["spürt,", 16.67, 17.15, 1.0], ["wenn", 17.15, 17.33, 1.0], ["man", 17.33, 17.5, 1.0], ["zu", 17.5, 17.65, 1.0], ["Fuß", 1