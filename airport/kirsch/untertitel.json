icht", 56.08, 56.36, 1.0], ["einfach", 56.36, 56.78, 1.0], ["eine", 56.78, 57.04, 1.0], ["Abbildung", 57.04, 57.61, 1.0], ["der", 57.61, 57.78, 1.0], ["Stadt,", 57.78, 58.19, 1.0], ["sondern", 58.44, 59.0, 1.0], ["mein", 59.0, 59.31, 1.0], ["Gefühl", 59.31, 59.96, 1.0], ["und", 60.33, 60.51, 1.0], ["meine", 60.51, 60.78, 1.0], ["Erinnerung", 60.78, 61.35, 1.0], ["an", 61.35, 61.52, 1.0], ["sie.", 61.52, 61.76, 1.0]]}]